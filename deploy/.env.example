# Knowii AI OS deployment configuration — copy to .env and fill in.
# Secrets never go in this file's committed form.

# Image tags (default: latest)
ENGINE_TAG=latest
WEB_TAG=latest

# PostgreSQL
POSTGRES_DB=knowii
POSTGRES_USER=knowii
POSTGRES_PASSWORD=

# Forgejo / vault git
GIT_DOMAIN=git.knowii.net

# LFS object storage (S3-compatible, from day one — no local-disk phase).
# Hetzner Object Storage or Cloudflare R2; endpoint WITHOUT scheme.
LFS_S3_ENDPOINT=
LFS_S3_ACCESS_KEY=
LFS_S3_SECRET_KEY=
LFS_S3_BUCKET=knowii-vault-lfs
